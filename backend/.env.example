# ====== Mietspiegel-AI Backend Configuration ======
# Copy this file to `.env` and fill in your values.

# --- Required: Mistral API ---
# Get yours at https://console.mistral.ai → API Keys
MISTRAL_API_KEY=

# --- Optional: Mistral Model Selection ---
# Default models are tuned for German language + JSON reliability.
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_CHAT_MODEL=mistral-large-latest

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=2
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR
ENV=development          # development | production

# --- CORS (comma-separated origins) ---
# Add your frontend origin (no trailing slash)
CORS_ORIGINS=http://localhost:4321,http://localhost:8000

# --- Cache (optional) ---
# Empty = in-memory LRU. Set to enable Redis.
REDIS_URL=

# --- Rate Limit ---
RATE_LIMIT_PER_MINUTE=10

# --- API Authentication (optional, for B2B embed users) ---
# If set, requests must include `X-API-Key: <key>` header.
# Leave empty for public access.
API_KEY=

# --- Misc ---
MAX_UPLOAD_MB=10
PDF_PARSER_TIMEOUT_SEC=30