---
/**
 * Versorger-Ratgeber: Strom, Gas & Internet (Glasfaser/Kabel/DSL/LTE/5G).
 * Statistisch ausgewertet (Breitbandatlas, Bundesnetzagentur, BREKO) mit
 * Fallstricken und Betrugsmaschen — damit Mieter nicht über den Tisch
 * gezogen werden.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Donate from "../components/Donate.astro";
---
<Layout title="Strom, Gas & Internet: Ratgeber gegen Fallstricke und Betrug">
  <Nav />
  <header>
    <h1>🔌 Strom, Gas &amp; Internet — der Ratgeber für deine Wohnung</h1>
    <p class="lede">
      Was kostet der Markt wirklich, wo lauern Fallstricke im Kleingedruckten
      und welche Betrugsmaschen gibt es? Statistisch untermauert, einfach
      erklärt — für Strom, Gas und alle Internet-Technologien.
    </p>
  </header>

  <main class="ratgeber">
    <!-- ============ STROM & GAS ============ -->
    <section id="strom">
      <h2>⚡ Strom &amp; Gas: Preisgarantie vs. Preisstandgarantie</h2>
      <p class="hint">
        Der wichtigste Fallstrick beim Anbieterwechsel ist ein Wort:
        <strong>"Preisgarantie" ≠ "Preisstandgarantie"</strong>
      </p>
      <table>
        <tr><th>Begriff</th><th>Was er wirklich bedeutet</th><th>Risiko</th></tr>
        <tr>
          <td><strong>Preisstandgarantie</strong></td>
          <td>Nur der <em>reine Energiepreis</em> des Anbieters ist fix — Steuern,
              Umlagen und <strong>Netzentgelte</strong> können weiter steigen
              (und werden oft 40–50 % der Rechnung!</td>
          <td>🟡 Klingt garantiert, aber die Rechnung kann trotzdem steigen</td>
        </tr>
        <tr>
          <td><strong>Preisgarantie (echt)</strong></td>
          <td><em>Alle</em> Preisbestandteile sind garantiert fix — Steuern und
              Netzentgelte inklusive.</td>
          <td>✅ Meist 12 Monate, teurer als "nur Energiepreis"</td>
        </tr>
        <tr>
          <td><strong>Bonus-/Sofortbonus</strong></td>
          <td>Einmaliger Rabatt nach 6–12 Monaten — oft an Bedingungen geknüpft
              (kein Umzug, keine vorzeitige Kündigung).</td>
          <td>🟡 Jahrespreis wird damit "künstlich" niedrig gerechnet —
              im 2. Jahr explodiert der Preis oft</td>
        </tr>
        <tr>
          <td><strong>Vorkasse / Kaution</strong></td>
          <td>Anbieter verlangt mehrere Monatsabschläge im Voraus.</td>
          <td>🔴 Bei Anbieterinsolvenz: Geld meist <strong>weg</strong> —
              Vorkasse-Anbieter mit extra-günstigen Preissen sind ein Warnsignal</td>
        </tr>
      </table>

      <h3>💡 Tipps, die dich schützen</h3>
      <ul class="tips">
        <li>Immer die <strong>Preisgarantie</strong> prüfen: Was genau ist garantiert? (Steuer & Netzentgelte inklusive?)</li>
        <li><strong>Abschlagspreisen</strong> (Grundgebühr + Arbeitspreis) vergleichen, nicht nur den beworbenen "Jahrespreis".</li>
        <li>Kündigungsfrist prüfen: bei Wechsel günstig, bei Unzufriedenheit teuer.</li>
        <li><strong>Nie am Telefon abschließen</strong> — echte Vergleiche gibt's nur schriftlich / online (Check24, Verivox, Idealo).</li>
        <li><strong>Neuanbieter-Check</strong>: Wie lange ist der Anbieter am Markt? Gibt es aktuelle Insolvenzen? (z.B. nach der Energiekrise 2022/23 dutzende Pleiten)</li>
      </ul>
    </section>

    <!-- ============ BETRUG ============ -->
    <section id="betrug">
      <h2>🚨 Betrugsmaschen bei Strom &amp; Gas</h2>
      <p class="hint">
        Quellen: Bundesnetzagentur, Verbraucherzentralen, Stadtwerke-Warnungen
        (laufend aktualisiert — Links unten).
      </p>
      <table>
        <tr><th>Masche</th><th>Erkennungszeichen</th><th>Schutz</th></tr>
        <tr>
          <td><strong>Falsche "Stadtwerke"</strong> am Telefon</td>
          <td>Anrufer kennt Name/Adresse/Zählernummer, redet von "Preisbremsen",
              "Preisgarantie" oder droht mit Stromsperre ("über Weihnachten")</td>
          <td><strong>Auflegen.</strong> Echte Stadtwerke rufen nie anonym an
              und fragen nie nach Zählernummer am Telefon. Ohne deine Daten
              kann niemand wechseln — die <em>Zählernummer</em> ist der Schlüssel!</td>
        </tr>
        <tr>
          <td><strong>Unterschobener Vertrag</strong> ("Anbieterwechsel-Betrug")</td>
          <td>Vertreter an der Haustür oder am Telefon fragt nach
              Zählerdaten "zur Bestätigung"</td>
          <td>Niemals Zählernummer, Zählerstand oder Unterschrift geben.
              Schriftliche Bestätigungen kommen oft erst <em>nach</em> Ablauf
              der Widerrufsfrist — dann ist der Wechsel schon durch.</td>
        </tr>
        <tr>
          <td><strong>"Bundesnetzagentur" oder "Energiezentrale" am Telefon</strong></td>
          <td>Behörden geben sich als angebliche offizielle Stelle aus, um
              "Preisbremsen" oder Zähleraustausch durchzusetzen</td>
          <td>Die Bundesnetzagentur ruft <strong>niemals</strong> an, um Verträge
              zu ändern oder Daten abzufragen. Auflegen und bei der echten
              Behörde melden.</td>
        </tr>
        <tr>
          <td><strong>Fake-"Smart-Meter"-Austausch</strong></td>
          <td>Anrufer behauptet, der Stromzähler <em>müsse</em> gegen einen
              intelligenten Zähler getauscht werden (EnWG §14a)</td>
          <td>Ein Zähler-Tausch läuft <strong>immer schriftlich</strong> über den
              Messstellenbetreiber — nie über einen telefonischen Vertrieb.</td>
        </tr>
      </table>
      <p class="hint">
        Opfer geworden? → Widerruf schriftlich an den neuen Anbieter +
        Verbraucherzentrale kontaktieren (Rückabwicklung). Unerlaubte
        Telefonwerbung ("Cold Calls") bei der
        <a href="https://www.bundesnetzagentur.de/DE/Vportal/Energie/aktuellehinweise.html" target="_blank" rel="noopener noreferrer">Bundesnetzagentur melden</a>.
      </p>
    </section>

    <!-- ============ INTERNET ============ -->
    <section id="internet">
      <h2>🌐 Internet: Glasfaser vs. Kabel vs. DSL vs. LTE/5G</h2>

      <h3>Statistik: Was steht in Deutschland wo? (Breitbandatlas, Dezember 2025)</h3>
      <table>
        <tr><th>Technologie</th><th>Verfügbarkeit (Haushalte)</th><th>Typische Speeds</th><th>Wann sinnvoll?</th></tr>
        <tr>
          <td><strong>FTTH/B (Glasfaser bis Wohnung/Gebäude)</strong></td>
          <td><strong>48,9 %</strong> (Dez. 2025) — Tendenz stark steigend</td>
          <td>100–1000+ Mbit/s symmetrisch (Upload = Download!)</td>
          <td>Immer wenn verfügbar — Zukunftstechnologie, stabil, kaum Latenz. Prüfe:
              <a href="https://gigabitgrundbuch.bund.de/GIGA/DE/Breitbandatlas/start.html" target="_blank" rel="noopener noreferrer">Breitbandatlas</a></td>
        </tr>
        <tr>
          <td><strong>Kabel (HFC, DOCSIS 3.1)</strong></td>
          <td>~8,5 Mio aktive Anschlüsse (2025, leicht sinkend)</td>
          <td>100–1000 Mbit/s Download, aber Upload oft nur 50 Mbit/s</td>
          <td>Gut für Streaming/Downloads; Upload-schwach = schlecht für
              Homeoffice/Videokonferenzen</td>
        </tr>
        <tr>
          <td><strong>DSL (Telefonleitung/Kupfer)</strong></td>
          <td>Noch ~58,5 % der aktiven Anschlüsse (2025, sinkend)</td>
          <td>16–250 Mbit/s, <em>abhängig von Leitungslänge</em></td>
          <td>Wo nichts anderes geht — Speed sinkt mit Entfernung zum Verteiler</td>
        </tr>
        <tr>
          <td><strong>LTE/5G (Mobilfunkfestnetz)</strong></td>
          <td>Flächendeckend, aber mit Tagesvolumen-Deckelung</td>
          <td>100–500 Mbit/s, aber oft Drosselung nach 50–200 GB</td>
          <td>Übergangslösung oder wenig genutzte Wohnung —
              <strong>kein Ersatz für Festnetz</strong> bei Homeoffice/Streaming-Haushalten</td>
        </tr>
      </table>
      <p class="hint">
        Technologieübergreifend (Glasfaser + Kabel): <strong>79,0 %</strong> der
        Haushalte haben Gigabit-Verfügbarkeit. Aber: Verfügbarkeit ≠
        Anschluss — nur ~29,8 % sind tatsächlich per Glasfaser
        <em>angeschlossen</em> (BREKO, Mitte 2026).
        <a href="https://gigabitbuero.de/artikel/neue-versorgungsdaten-im-breitbandatlas-verfugbar-datenstand-dezember-2025/" target="_blank" rel="noopener noreferrer">Quelle: Gigabitbüro des Bundes</a>.
      </p>

      <h3>⚠️ Fallstricke bei Internet-Verträgen</h3>
      <table>
        <tr><th>Falle</th><th>Erklärung</th><th>Gegenmittel</th></tr>
        <tr>
          <td><strong>"Bis zu"-Geschwindigkeit</strong></td>
          <td>Anbieter wirbt mit "bis zu 1000 Mbit/s" — real kommen oft nur
              10–40 % davon an</td>
          <td>Messen mit <a href="https://www.breitbandmessung.de/" target="_blank" rel="noopener noreferrer">breitbandmessung.de</a>
              (Verbraucherzentrale-Tool). Bei dauerhaft weniger als versprochen:
              <strong>Sonderkündigungsrecht</strong>!</td>
        </tr>
        <tr>
          <td><strong>Drosselung / Fair-Use-Policy</strong></td>
          <td>Nach Volumen-Limit wird der Speed gedrosselt (v.a. bei LTE/5G-Tarifen)</td>
          <td>Volumen-Limit im Vertrag prüfen — für Wohnungs-Alltag min. "unbegrenzt" oder >300 GB</td>
        </tr>
        <tr>
          <td><strong>Router-Zwang / Kaufmiete</strong></td>
          <td>Teure Miete für Zwangs-Router, oder Router muss gekauft werden</td>
          <td>Seit 2016 ist <strong>Routerfreiheit</strong> Gesetz (TKG §73) —
              jeder Anbieter muss fremde Router zulassen</td>
        </tr>
        <tr>
          <td><strong>Automatische Verlängerung / 24-Monats-Falle</strong></td>
          <td>Nach Erstlaufzeit verlängert sich der Vertrag oft still um 12 Monate</td>
          <td>Kündigungsfrist prüfen (oft 3 Monate vor Laufzeitende) —
              Wechselservice nutzen (Check24/Verivox erinnern kostenlos)</td>
        </tr>
        <tr>
          <td><strong>"Kostenlose" Hardware / Installationspauschale</strong></td>
          <td>Angebot lockt mit 0 €, im Kleingedruckten: 100–200 € Aktivierung
              oder Bereitstellungspreis</td>
          <td>Einmalpreis vs. monatlicher Preis immer zusammen rechnen</td>
        </tr>
        <tr>
          <td><strong>Betrug: Fake-Techniker / Phishing</strong></td>
          <td>"Techniker" klingelt und will "den Router prüfen" — tatsächlich
              Datendiebstahl oder Vertragsumstellung</td>
          <td>Niemals Fremde an Router/PC lassen. Router-Passwort ändern;
              Phishing-Mails mit Link nicht anklicken — Anbieter fragen nie
              nach Passwort per Mail</td>
        </tr>
      </table>
    </section>

    <!-- ============ CHECKLISTE UMZUG ============ -->
    <section id="checkliste">
      <h2>✅ Checkliste: Versorger-Wechsel in der neuen Wohnung</h2>
      <ol class="steps">
        <li><strong>Vor Einzug</strong>: Verfügbarkeit prüfen —
            <a href="https://gigabitgrundbuch.bund.de/GIGA/DE/Breitbandatlas/start.html" target="_blank" rel="noopener noreferrer">Breitbandatlas</a> ( Glasfaser/Kabel/DSL) und
            Mobilfunk-Abdeckung (LTE/5G)</li>
        <li><strong>Grundversorger-Klausel</strong>: Ohne Vertrag bist du automatisch im
            <em>Grundversorger-Tarif</em> (teuerste Option!) — aktiv wechseln spart
            oft 200–400 €/Jahr</li>
        <li><strong>Niemals Grundgebühr zahlen, ohne Arbeitspreis zu prüfen</strong>:
            Cent/kWh ist die eigentliche Kostengröße</li>
        <li><strong>Internet: Mindestlaufzeit 24 Monate ist Standard</strong> —
            kürzere gibt's oft bei kleinen Anbietern, aber prüfe deren Bonität
            (Vorkasse = Risiko)</li>
        <li><strong>Zählerstand fotografieren</strong> am Einzugstag — belegt
            deinen Verbrauchs-Start und schützt vor Alt-Schulden</li>
        <li><strong>Schriftlich kündigen</strong> beim Alt-Anbieter (Einzug = neuer
            Lieferant über Zählernummer, aber Kündigung muss trotzdem selbst
            erfolgen — sonst läuft der alte Vertrag weiter!)</li>
      </ol>
    </section>

    <!-- ============ QUELLEN ============ -->
    <section id="quellen">
      <h2>📚 Quellen</h2>
      <ul>
        <li>
          <a href="https://gigabitgrundbuch.bund.de/GIGA/DE/Breitbandatlas/start.html" target="_blank" rel="noopener noreferrer">Breitbandatlas (Bundesnetzagentur)</a> — halbjährliche, adressscharfe Verfügbarkeitsdaten
        </li>
        <li>
          <a href="https://gigabitbuero.de/artikel/neue-versorgungsdaten-im-breitbandatlas-verfugbar-datenstand-dezember-2025/" target="_blank" rel="noopener noreferrer">Gigabitbüro des Bundes</a> — Glasfaser 48,91 % (Dez. 2025)
        </li>
        <li>
          <a href="https://www.bundesnetzagentur.de/DE/Vportal/Energie/aktuellehinweise.html" target="_blank" rel="noopener noreferrer">Bundesnetzagentur: Betrugsmaschen Energie</a>
        </li>
        <li>
          <a href="https://www.breitbandmessung.de/" target="_blank" rel="noopener noreferrer">Breitbandmessung.de</a> — Verbraucherzentrale-Tool für Geschwindigkeitsmessung
        </li>
      </ul>
    </section>

    <!-- ============ TARIF-FINDER: Der echte Mehrwert ============ -->
    <section id="tarif-finder">
      <h2>🎯 Finde wirklich den günstigsten Anbieter</h2>
      <p class="hint">
        Ein Portal allein reicht nicht — Rankings sind provisions-geprägt.
        PLZ eingeben → alle großen Vergleiche auf einen Klick → Preise ablesen
        → Sparpotenzial berechnen. Fertig.
      </p>
      <div class="finder">
        <div class="plz-row">
          <label> Deine PLZ
            <input type="text" id="vf-plz" inputmode="numeric" maxlength="5" placeholder="10117" />
          </label>
          <label> Sparte
            <select id="vf-product">
              <option value="strom" selected>⚡ Strom</option>
              <option value="gas">🔥 Gas</option>
              <option value="dsl">🌐 DSL / Internet</option>
              <option value="mobilfunk">📱 Mobilfunk</option>
            </select>
          </label>
          <button id="vf-go" type="button">Vergleiche öffnen</button>
        </div>
        <div id="vf-iframe-box" class="iframe-box" hidden>
          <p class="hint">⚙️ White-Label-Tarifrechner (Verivox) — direkt hier vergleichen und abschließen:</p>
          <iframe id="vf-iframe" title="Verivox Tarifrechner" loading="lazy"></iframe>
        </div>
        <div id="vf-lokal" class="lokal-box" hidden>
          <p><strong>🔌 Lokale Anbieter an deiner PLZ</strong> <span class="hint">(Grundversorger = teuerster Tarif, ohne Vertrag zahlst du ihn automatisch!)</span></p>
          <div id="vf-lokal-content"></div>
        </div>
        <div id="vf-links" class="portal-links" hidden>
          <p><strong>Vergleiche jetzt auf allen Portalen</strong> (mindestens 2 nutzen!):</p>
          <div id="vf-link-list"></div>
          <p class="hint" id="vf-tip"></p>
        </div>
        <div class="sparrechner">
          <h3>🧮 Sparpotenzial berechnen (Preise aus dem Vergleich ablesen)</h3>
          <div class="grid">
            <label> Jahresverbrauch (kWh)
              <input type="number" id="sr-kwh" value="4000" min="100" />
            </label>
            <label> Grundversorger (ct/kWh)
              <input type="number" id="sr-grund" value="40" step="0.01" />
            </label>
            <label> Günstigster Tarif (ct/kWh)
              <input type="number" id="sr-tarif" value="28" step="0.01" />
            </label>
            <label> Grundgebühr Versorger (€/Jahr)
              <input type="number" id="sr-gg1" value="0" step="0.01" />
            </label>
            <label> Grundgebühr Tarif (€/Jahr)
              <input type="number" id="sr-gg2" value="0" step="0.01" />
            </label>
          </div>
          <button id="sr-go" type="button">Ersparnis berechnen</button>
          <div id="sr-result" class="result-box" hidden><div id="sr-output"></div></div>
        </div>
        <div class="beobachtungen">
          <h3>📊 Preis-Beobachtung eintragen → Portal-Statistik</h3>
          <p class="hint">Lies aus den Portalen den günstigsten ct/kWh-Preis ab und trage ihn je Portal ein — die Statistik rechnet, wer wirklich am günstigsten ist (Median, robust gegen Lock-Angebote).</p>
          <div class="grid">
            <label> Portal
              <select id="ob-portal">
                <option value="verivox">Verivox</option>
                <option value="check24">Check24</option>
                <option value="idealo">Idealo</option>
                <option value="anbieter">Anbieter direkt</option>
              </select>
            </label>
            <label> Tarifname
              <input type="text" id="ob-name" placeholder="z.B. ÖkoStrom 12" />
            </label>
            <label> ct/kWh
              <input type="number" id="ob-ct" step="0.01" min="0" />
            </label>
          </div>
          <button id="ob-go" type="button">Beobachtung speichern</button>
          <button id="ob-stats" type="button" style="margin-left: 0.5rem;">📊 Statistik anzeigen</button>
          <div id="ob-result" class="result-box" hidden></div>
        </div>

        <div class="strompreise">
          <h3>📉 Aktueller Börsenstrompreis (SMARD / BNetzA)</h3>
          <p class="hint">Für Dynamic-Tariff-Mieter: Wann ist Strom aktuell günstig?</p>
          <button id="sp-go" type="button">Strompreise laden</button>
          <div id="sp-result" hidden>
            <div id="sp-cheap"></div>
            <div id="sp-expensive"></div>
            <p class="hint">Quelle: Bundesnetzagentur SMARD · CC BY 4.0 · Börsenpreis, nicht Haushaltspreis</p>
          </div>
        </div>
      </div>
    </section>

    <Donate />
  </main>

  <footer>
    <a href="/">← Mietpreis-Check</a> ·
    <a href="/werkzeuge">Werkzeuge</a> ·
    <a href="/handbuch">Handbuch Mietwucher</a> ·
    <a href="/gesetze">Gesetze & Politik</a> · <a href="/wohnalltag">Wohnalltag</a>
  </footer>
</Layout>

<style>
  h1 { text-align: center; padding: 2rem 1rem 0; color: var(--color-accent); margin: 0; }
  .lede { text-align: center; color: var(--color-muted); max-width: 700px; margin: 0 auto 2rem; padding: 0 1rem; }
  .ratgeber { max-width: 820px; margin: 0 auto 3rem; padding: 0 1rem; }
  section { margin-bottom: 2.5rem; }
  h2 { border-bottom: 2px solid #e0e0e0; padding-bottom: 0.4rem; }
  h3 { margin-top: 1.5rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.92rem; }
  th, td { border: 1px solid #ddd; padding: 0.55rem; text-align: left; vertical-align: top; }
  th { background: #f2f2f2; }
  .hint { color: #666; font-size: 0.88rem; }
  .tips li { margin-bottom: 0.5rem; line-height: 1.45; }
  .steps li { margin-bottom: 0.8rem; line-height: 1.5; }
  footer { text-align: center; padding: 2rem; color: #888; font-size: 0.85rem; }
  .finder { background: #f4f8ff; border-radius: 12px; padding: 1.5rem; margin-top: 1rem; }
  .plz-row { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end; }
  .plz-row input, .plz-row select { padding: 0.55rem; border: 1px solid #bbb; border-radius: 6px; font-size: 1rem; }
  .finder button { padding: 0.6rem 1.2rem; background: #0066cc; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 1rem; margin-top: 0.5rem; }
  .finder button:hover { background: #0055aa; }
  .lokal-box { margin-top: 1.2rem; padding: 1rem; background: #fff8e8; border: 1px solid #e8d5a8; border-radius: 8px; font-size: 0.95rem; }
  .portal-links { margin-top: 1.2rem; padding: 1rem; background: #eef4ee; border-radius: 8px; }
  .portal-links a { display: inline-block; margin: 0.4rem 0.6rem 0.4rem 0; padding: 0.5rem 1rem; background: #0066cc; color: white; text-decoration: none; border-radius: 6px; font-weight: 600; }
  .portal-links a:hover { background: #0055aa; }
  .sparrechner, .strompreise { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed #bbb; }
  .result-box { margin-top: 1rem; padding: 1rem; background: #e8f5e8; border-radius: 8px; font-size: 1.05rem; }
  .iframe-box { margin-top: 1.2rem; }
  .iframe-box iframe { width: 100%; min-height: 1400px; border: 1px solid #ccc; border-radius: 8px; background: white; }
</style>

<script>
  const VBACKEND =
    (import.meta.env.PUBLIC_BACKEND_URL as string | undefined) ??
    "http://localhost:8765";
  const vErr = (msg: string): void => {
    const e = document.getElementById("error");
    if (e) { e.textContent = "⚠️ " + msg; e.hidden = false; }
  };

  // ---- Tarif-Finder: alle Portale auf einen Klick ----
  document.getElementById("vf-go")?.addEventListener("click", async () => {
    const plz = (document.getElementById("vf-plz") as HTMLInputElement | null)?.value?.trim() ?? "";
    const product = (document.getElementById("vf-product") as HTMLSelectElement | null)?.value ?? "strom";
    if (!/^\d{5}$/.test(plz)) { vErr("Bitte eine gültige 5-stellige PLZ eingeben."); return; }
    try {
      const r = await fetch(`${VBACKEND}/api/versorger/vergleiche?postal_code=${plz}&product=${product}`);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      const list = document.getElementById("vf-link-list");
      if (list) {
        list.innerHTML = (d.vergleiche as Array<{ portal: string; url: string }>)
          .map((v) => `<a href="${v.url}" target="_blank" rel="noopener noreferrer">${v.portal} ↗</a>`)
          .join("");
      }
      const tip = document.getElementById("vf-tip");
      if (tip) tip.textContent = d.tip as string;
      const iframeUrl = d.iframe_url as string | null;
      const iframeBox = document.getElementById("vf-iframe-box");
      if (iframeUrl && iframeBox) {
        const frame = document.getElementById("vf-iframe") as HTMLIFrameElement | null;
        if (frame) {
          frame.src = iframeUrl;
          iframeBox.hidden = false;
        }
      }
      const box = document.getElementById("vf-links");
      if (box) box.hidden = false;
      // Lokale Anbieter direkt anzeigen
      try {
        const lr = await fetch(`${VBACKEND}/api/versorger/lokal/${plz}`);
        if (lr.ok) {
          const ld = await lr.json();
          const c = document.getElementById("vf-lokal-content");
          if (c) {
            let h = "";
            if (ld.grundversorger) {
              h += `<p style="margin:0.4rem 0;">⚖️ Grundversorger: <strong>${ld.grundversorger.name}</strong>${ld.grundversorger.website ? ` — <a href="${ld.grundversorger.website}" target="_blank" rel="noopener noreferrer">Website ↗</a>` : ""}</p>`;
            }
            if ((ld.lokale_versorger as string[]).length > 0) {
              h += `<p style="margin:0.4rem 0;">🏙️ Stadtwerke: ${ld.lokale_versorger.join(" · ")}</p>`;
            }
            h += `<p style="margin:0.4rem 0;">🌐 <a href="${ld.breitband_check_url}" target="_blank" rel="noopener noreferrer">Internet-Verfügbarkeit prüfen (Breitbandatlas) ↗</a></p>`;
            h += `<p class="hint" style="margin:0.4rem 0;">${ld.hint as string}</p>`;
            c.innerHTML = h;
          }
          const lb = document.getElementById("vf-lokal");
          if (lb) lb.hidden = false;
        }
      } catch { /* lokal-Info optional */ }
    } catch (e) { vErr(e instanceof Error ? e.message : String(e)); }
  });

  // ---- Sparrechner ----
  document.getElementById("sr-go")?.addEventListener("click", async () => {
    const num = (id: string): number =>
      parseFloat((document.getElementById(id) as HTMLInputElement | null)?.value ?? "0") || 0;
    const body = {
      jahresverbrauch_kwh: num("sr-kwh"),
      grundversorger_ct_kwh: num("sr-grund"),
      guenstigster_tarif_ct_kwh: num("sr-tarif"),
      grundgebuehr_grundversorger_eur: num("sr-gg1"),
      grundgebuehr_tarif_eur: num("sr-gg2"),
    };
    if (body.jahresverbrauch_kwh <= 0 || body.grundversorger_ct_kwh <= 0) {
      vErr("Bitte Verbrauch und Grundversorger-Preis angeben.");
      return;
    }
    try {
      const r = await fetch(`${VBACKEND}/api/tools/sparrechner`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      const out = document.getElementById("sr-output");
      if (out) {
        out.innerHTML = `
          <p>Grundversorger: <strong>${(d.jahreskosten_grundversorger_eur as number).toFixed(2)} €/Jahr</strong></p>
          <p>Günstigster Tarif: <strong>${(d.jahreskosten_tarif_eur as number).toFixed(2)} €/Jahr</strong></p>
          <p>💰 <strong>Ersparnis: ${(d.ersparnis_eur as number).toFixed(2)} €/Jahr (${(d.ersparnis_prozent as number).toFixed(1)} %)</strong></p>
          <p class="hint">${d.empfehlung as string}</p>`;
      }
      const box = document.getElementById("sr-result");
      if (box) box.hidden = false;
    } catch (e) { vErr(e instanceof Error ? e.message : String(e)); }
  });

  // ---- Tarif-Beobachtung + Statistik ----
  document.getElementById("ob-go")?.addEventListener("click", async () => {
    const plz = (document.getElementById("vf-plz") as HTMLInputElement | null)?.value?.trim() ?? "";
    const product = (document.getElementById("vf-product") as HTMLSelectElement | null)?.value ?? "strom";
    const portal = (document.getElementById("ob-portal") as HTMLSelectElement | null)?.value ?? "verivox";
    const name = (document.getElementById("ob-name") as HTMLInputElement | null)?.value?.trim() ?? "";
    const ct = parseFloat((document.getElementById("ob-ct") as HTMLInputElement | null)?.value ?? "0") || 0;
    const out = document.getElementById("ob-result");
    if (!/^\d{5}$/.test(plz)) { if (out) { out.textContent = "⚠️ Bitte oben eine gültige PLZ eingeben."; out.hidden = false; } return; }
    if (!name || ct <= 0) { if (out) { out.textContent = "⚠️ Tarifname und ct/kWh bitte ausfüllen."; out.hidden = false; } return; }
    try {
      const r = await fetch(`${VBACKEND}/api/versorger/beobachtung`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ portal, product, postal_code: plz, tariff_name: name, ct_per_kwh: ct }),
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      if (out) { out.textContent = `✅ Beobachtung gespeichert: ${portal} · ${name} · ${ct} ct/kWh`; out.hidden = false; }
      (document.getElementById("ob-name") as HTMLInputElement).value = "";
      (document.getElementById("ob-ct") as HTMLInputElement).value = "";
    } catch (e) {
      if (out) { out.textContent = `⚠️ ${e instanceof Error ? e.message : String(e)}`; out.hidden = false; }
    }
  });

  document.getElementById("ob-stats")?.addEventListener("click", async () => {
    const plz = (document.getElementById("vf-plz") as HTMLInputElement | null)?.value?.trim() ?? "";
    const product = (document.getElementById("vf-product") as HTMLSelectElement | null)?.value ?? "strom";
    const out = document.getElementById("ob-result");
    if (!/^\d{5}$/.test(plz)) { if (out) { out.textContent = "⚠️ Bitte oben eine gültige PLZ eingeben."; out.hidden = false; } return; }
    try {
      const r = await fetch(`${VBACKEND}/api/versorger/statistik?product=${product}&postal_code=${plz}`);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      type Rank = { portal: string; observation_count: number; min_ct_kwh: number | null; median_ct_kwh: number | null; avg_ct_kwh: number | null; cheapest_tariff: string | null };
      if (out) {
        const rows = (d.ranking as Rank[]).map((s, i) =>
          `<tr><td>${i + 1}.</td><td>${s.portal}</td><td>${s.observation_count}</td><td>${s.min_ct_kwh ?? "—"}</td><td><strong>${s.median_ct_kwh ?? "—"}</strong></td><td>${s.avg_ct_kwh ?? "—"}</td><td>${s.cheapest_tariff ?? ""}</td></tr>`
        ).join("");
        out.innerHTML = `
          <p><strong>Portal-Ranking</strong> (${d.observation_count} Beobachtungen für ${product} ${plz}):</p>
          ${rows ? `<table style="width:100%; border-collapse:collapse; font-size:0.9rem;"><tr style="background:#eee"><th>#</th><th>Portal</th><th>n</th><th>min ct</th><th>Median ct</th><th>Ø ct</th><th>Günstigster Tarif</th></tr>${rows}</table>` : ""}
          <p class="hint">${d.insight as string}</p>`;
        out.hidden = false;
      }
    } catch (e) {
      if (out) { out.textContent = `⚠️ ${e instanceof Error ? e.message : String(e)}`; out.hidden = false; }
    }
  });

  // ---- SMARD Live-Strompreise ----
  document.getElementById("sp-go")?.addEventListener("click", async () => {
    try {
      const r = await fetch(`${VBACKEND}/api/versorger/strompreise`);
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      type HourEntry = { timestamp: string; price_ct_per_kwh: number };
      const fmt = (h: HourEntry[]): string =>
        h.slice(0, 3)
          .map((x) => `${new Date(x.timestamp).getHours()}:00 Uhr — ${x.price_ct_per_kwh} ct/kWh`)
          .join("<br />");
      const cheap = document.getElementById("sp-cheap");
      if (cheap) cheap.innerHTML = `<strong>✅ Günstigste Stunden:</strong><br />${fmt(d.cheapest_hours)}`;
      const exp = document.getElementById("sp-expensive");
      if (exp) exp.innerHTML = `<strong>🔴 Teuerste Stunden:</strong><br />${fmt(d.most_expensive_hours)}`;
      const box = document.getElementById("sp-result");
      if (box) box.hidden = false;
    } catch (e) { vErr(e instanceof Error ? e.message : String(e)); }
  });
</script>
