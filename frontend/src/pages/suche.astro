---
/**
 * Wohnungssuche-Strategie + Roadmap für den Multi-Portal-Such-Agenten.
 * Praktisch für Mieter UND Mietsuchende: wie findet man günstig Wohnungen —
 * und was unser geplanter Open-Source-Such-Agent darüber hinaus tun wird.
 */
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Donate from "../components/Donate.astro";
---
<Layout title="Günstig Wohnungen finden — Such-Strategie & geplanter Such-Agent">
  <Nav />
  <header>
    <h1>🔎 Günstig Wohnungen finden — die komplette Strategie</h1>
    <p class="lede">
      Der Markt ist schnell: Gute Objekte sind oft nach Stunden weg. Hier
      lernst du das Spiel — und wir bauen einen <strong>freien Open-Source-
      Such-Agenten</strong>, der dir die Arbeit abnimmt.
    </p>
  </header>

  <main class="suche">
    <!-- ============ WARUM SO SCHNELL REAGIEREN ============ -->
    <section id="strategie">
      <h2>⚡ Die 5 Hebel der erfolgreichen Wohnungssuche</h2>
      <ol class="steps">
        <li>
          <strong>Alle Portale gleichzeitig</strong>: ImmoScout24 (größte
          Auswahl), Immowelt + Immonet (2. Wahl-Pool, weniger Konkurrenz),
          Kleinanzeigen (private Vermieter, oft günstiger!), WG-Gesucht,
          Wohnungsbaugesellschaften direkt (Howoge, Gewobag, GAG …).
        </li>
        <li>
          <strong>Suchaufträge mit Push-Benachrichtigung</strong> einrichten —
          E-Mail-Benachrichtigungen kommen gebündelt und zu spät. Minuten
          entscheiden, wer die Wohnung bekommt.
        </li>
        <li>
          <strong>1–2 Stunden Reaktionsfenster</strong>: Wer zuerst antwortet,
          bekommt den Besichtigungstermin. Bewerbungsmappe (SCHUFA,
          Gehaltsnachweis, Mieterselbstauskunft) <em>vorbereitet</em> halten.
        </li>
        <li>
          <strong>Duplikate erkennen</strong>: Dieselbe Wohnung läuft oft
          parallel auf mehreren Portalen — teils mit unterschiedlichen
          Preisen. Immer die günstigste Variante kontaktieren.
        </li>
        <li>
          <strong>Wohnungsbaugesellschaften & Genossenschaften</strong> direkt
          anschreiben — deren Objekte tauchen selten auf Portalen auf, sind
          aber oft deutlich unter Marktpreis (kostenlose Wartelisten!).
        </li>
      </ol>
    </section>

    <!-- ============ SUCH-AGENT UI ============ -->
    <!-- ============ EINFACHE ORT-SUCHE (Haupt-Eingabe) ============ -->
    <section id="ort-suche">
      <h2>📍 Wo willst du wohnen?</h2>
      <p class="hint">Einfach eintippen — Bezirk, Stadt oder PLZ. Kein Portal-URL-Kopieren mehr nötig.</p>
      <div class="ort-box">
        <div class="ort-row">
          <input type="text" id="ort-input" placeholder="z.B. Kreuzberg, Berlin Torstraße, oder 10117…" />
          <input type="number" id="ort-rent" placeholder="max. Miete €" min="0" style="max-width:130px" />
          <input type="number" id="ort-rooms" placeholder="Zimmer ab" min="0" step="0.5" style="max-width:110px" />
          <button id="ort-go" type="button">🔍 Suchen</button>
        </div>
        <div id="ort-result" hidden>
          <p id="ort-hint" class="hint"></p>
          <div id="ort-urls"></div>
          <button id="ort-save-agent" type="button" hidden>🤖 Als Such-Agent speichern (auto. Benachrichtigung)</button>
        </div>
      </div>
    </section>

    <section id="agent-ui">
      <h2>🤖 Dein Such-Agent — jetzt nutzen</h2>
      <p class="hint">
        Such-URL aus dem Portal kopieren (ImmoScout / Immowelt / Kleinanzeigen /
        WG-Gesucht wird automatisch erkannt) → Profil speichern → auf Klick prüfen
        (oder automatisch alle 10 Minuten). Neue Treffer mit Mietpreis-Badge.
      </p>
      <div class="agent-box">
        <h3>Profil anlegen</h3>
        <label> Name
          <input type="text" id="sp-name" placeholder="Berlin 2-Zimmer bis 1000 €" />
        </label>
        <label> Such-URL (aus dem Portal kopieren)
          <input type="url" id="sp-url" placeholder="https://www.immobilienscout24.de/Suche/de/berlin/berlin/wohnung-mieten?price=-1000.0" />
        </label>
        <button id="sp-save" type="button">Profil speichern</button>
        <p class="hint" id="sp-saved" hidden></p>
        <h3>Deine Profile</h3>
        <div id="sp-list"></div>
        <div id="sp-results" hidden>
          <h3 id="sp-results-title">Ergebnisse</h3>
          <div id="sp-listings"></div>
        </div>
      </div>
    </section>

    <!-- ============ GEPLAN SUCH-AGENT ============ -->
    <section id="agent">
      <h2>🤖 Unser geplanter Such-Agent (Roadmap)</h2>
      <p>
        Es gibt bereits kommerzielle Anbieter in diesem Raum —
        <strong>Traumwohnung.ai</strong> und <strong>Wohnly.ai</strong>
        (KI-Agenten, die sich automatisch bewerben, kostenpflichtig) sowie den
        <strong>Immobilien Bot</strong> (App, 26 Portale, Echtzeit-Push).
        Unser Unterschied: <strong>Open Source, self-hosted, kostenlos,
        DSGVO-konform</strong> — gebaut auf dem <a href="https://github.com/neopostmodern/wohnungsbot" target="_blank" rel="noopener noreferrer">Wohnungsbot</a>-Prinzip
        (AGPL-3.0), der als Open-Source-Projekt genau bewiesen hat, dass das
        funktioniert.
      </p>

      <h3>Was der Agent tun wird</h3>
      <table>
        <tr><th>Feature</th><th>Wie</th><th>Status</th></tr>
        <tr>
          <td><strong>Multi-Portal-Suche</strong></td>
          <td>ImmoScout24, Immowelt, Immonet, Kleinanzeigen, WG-Gesucht
              parallel abfragen (RSS/Export-Feeds, wo vorhanden)</td>
          <td>🚧 In Planung — als separates Modul im Backend</td>
        </tr>
        <tr>
          <td><strong>Duplikat-Erkennung</strong></td>
          <td>Hash über Adresse + Größe + Zimmer — dieselbe Wohnung auf
              verschiedenen Portalen wird nur einmal gemeldet, mit
              Preis-Vergleich ("Auf Kleinanzeigen 80 € günstiger!")</td>
          <td>🚧 In Planung</td>
        </tr>
        <tr>
          <td><strong>Mietpreis-Check integriert</strong></td>
          <td>Jedes Suchergebnis wird automatisch gegen den Mietspiegel
              geprüft (bestehende Engine!) — Badge direkt im Ergebnis:
              "fair" / "überhöht (§556d-Verdacht!)"</td>
          <td>✅ Engine existiert (diese App), Integration geplant</td>
        </tr>
        <tr>
          <td><strong>Benachrichtigung</strong></td>
          <td>E-Mail / Telegram / Web-Push — kein Zwangs-Account, self-hosted</td>
          <td>🚧 In Planung</td>
        </tr>
        <tr>
          <td><strong>Betrugs-Filter</strong></td>
          <td>Anzeigen auffinden, die unter Marktpreis liegen &amp; nach
              Vorkasse fragen (klassische Mietbetrugs-Masche — siehe
              <a href="/versorger">Betrugsmaschen</a>)</td>
          <td>🚧 In Planung</td>
        </tr>
      </table>

      <h3>Wie du mithelfen kannst</h3>
      <ul class="tips">
        <li>⭐ Repo auf GitHub forken/starren — jedes Issue zählt</li>
        <li>🧪 Test-Mieter: gesucht, sobald die erste Alpha steht</li>
        <li>💡 Portal-Suche erleben? Erzähl uns, was <em>dir</em> fehlt — Issues erwünscht</li>
      </ul>
      <p class="hint">
        Rechtlicher Hinweis: Portale verbieten Scraping teils in ihren AGB.
        Wir setzen auf offizielle Feeds/Exporte, wo vorhanden (ImmoScout
        bietet RSS), und/oder den Klassiker: Benachrichtigungs-Mails
        auswerten, die der Nutzer <em>selbst</em> abonniert hat. Kein
        ToS-Verstoß, keine Grauzone.
      </p>
    </section>

    <!-- ============ FINANZIELLE FALLSTRICKE BEI DER SUCHE ============ -->
    <section id="fallen">
      <h2>🚨 Fallstricke bei der Wohnungssuche</h2>
      <table>
        <tr><th>Falle</th><th>Erkennung</th><th>Schutz</th></tr>
        <tr>
          <td><strong>Mietbetrug (Vorkasse)</strong></td>
          <td>Anzeige weit unter Marktpreis, "Eigentümer im Ausland",
              Zahlung per Western Union / Crypto vor Besichtigung gefordert</td>
          <td><strong>Niemals zahlen vor Besichtigung + Unterschlagung.</strong>
              Fotos per Reverse-Image-Suche (Google Lens) prüfen — Betrüger
              kopieren echte Portal-Fotos.</td>
        </tr>
        <tr>
          <td><strong>Makler-Provision (Courtage)</strong></td>
          <td>Bei "Vermietung durch Bestandsvermieter" darf der Makler max.
              2 Kaltmieten + MwSt verlangen — aber nur wenn der Vermieter
              den Makler beauftragt hat, nicht du!</td>
          <td>Wer "den Makler beauftragt" hat, muss im Exposé stehen.
              Direkt beim Vermieter nachfragen.</td>
        </tr>
        <tr>
          <td><strong>Mietpreisbremse prüfen!</strong></td>
          <td>Angebot deutlich über Mietspiegel — egal wie schön die Wohnung</td>
          <td>Direkt nach dem Upload des Mietvertrags mit dem
              <a href="/">Mietpreis-Check</a> prüfen. Überhöhte Startmiete
              kann rückwirkend sanktioniert werden.</td>
        </tr>
        <tr>
          <td><strong>Wohnflächen-Schummeln</strong></td>
          <td>Wohnfläche wird mit Balkon/Schrägen "aufgerechnet"</td>
          <td>WoFlV beachten: Balkon zählt max. 50 %, Schrägen ab 1 m Höhe
              zählen — Wohnfläche nachmessen, bei >10 % Abweichung
              Minderung + Rückforderung (3 Jahre)</td>
        </tr>
      </table>
    </section>

    <Donate />
  </main>

  <footer>
    <a href="/">← Mietpreis-Check</a> ·
    <a href="/werkzeuge">Werkzeuge</a> ·
    <a href="/handbuch">Handbuch</a>
  </footer>
</Layout>

<style>
  h1 { text-align: center; padding: 2rem 1rem 0; color: var(--color-accent); margin: 0; }
  .lede { text-align: center; color: var(--color-muted); max-width: 700px; margin: 0 auto 2rem; padding: 0 1rem; }
  .suche { max-width: 820px; margin: 0 auto 3rem; padding: 0 1rem; }
  section { margin-bottom: 2.5rem; }
  h2 { border-bottom: 2px solid #e0e0e0; padding-bottom: 0.4rem; }
  h3 { margin-top: 1.5rem; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; font-size: 0.92rem; }
  th, td { border: 1px solid #ddd; padding: 0.55rem; text-align: left; vertical-align: top; }
  th { background: #f2f2f2; }
  .hint { color: #666; font-size: 0.88rem; }
  .tips li { margin-bottom: 0.5rem; line-height: 1.45; }
  .steps li { margin-bottom: 0.9rem; line-height: 1.5; }
  footer { text-align: center; padding: 2rem; color: #888; font-size: 0.85rem; }
  .ort-box { background: #f4f8ff; border-radius: 12px; padding: 1.5rem; margin-top: 1rem; }
  .ort-row { display: grid; grid-template-columns: 1fr 130px 110px auto; gap: 0.6rem; }
  .ort-row input { padding: 0.7rem; border: 1px solid #bbb; border-radius: 6px; font-size: 1rem; }
  .ort-row button { padding: 0.7rem 1.3rem; background: #0066cc; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 1rem; font-weight: 600; }
  .ort-row button:hover { background: #0055aa; }
  .agent-box { background: #f4f8ff; border-radius: 12px; padding: 1.5rem; margin-top: 1rem; }
  .agent-box label { display: block; margin: 0.6rem 0; font-size: 0.9rem; }
  .agent-box input { width: 100%; padding: 0.55rem; border: 1px solid #bbb; border-radius: 6px; font-size: 0.95rem; box-sizing: border-box; }
  .agent-box button { padding: 0.6rem 1.2rem; background: #0066cc; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 1rem; margin-top: 0.5rem; }
  .agent-box button:hover { background: #0055aa; }
  .profile-card { display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap; background: white; padding: 0.7rem 1rem; border-radius: 8px; margin: 0.4rem 0; }
  .profile-card .p-name { font-weight: 600; }
  .profile-card .p-url { color: #666; font-size: 0.8rem; flex: 1; min-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .profile-card button { margin-top: 0 !important; padding: 0.35rem 0.8rem !important; font-size: 0.85rem !important; }
  .listing-row { background: white; border-radius: 8px; padding: 0.7rem 1rem; margin: 0.4rem 0; font-size: 0.92rem; }
  .listing-row a { color: #0066cc; text-decoration: none; font-weight: 600; }
  .badge-sm { font-weight: 700; }
  .wp-btn { padding: 0.25rem 0.6rem !important; font-size: 0.78rem !important; margin: 0 0 0 0.4rem !important; background: #2e7d32 !important; }
</style>

<script>
  const SB = (import.meta.env.PUBLIC_BACKEND_URL as string | undefined) ?? "http://localhost:8765";
  const badgeEmoji = (v: string): string =>
    ({ fair: "✅", tolerance: "🟡", brake: "🟠", wucher: "🔴", unknown: "⚪" } as Record<string, string>)[v] ?? "⚪";

  type Profile = { id: number; name: string; url: string; city: string | null };
  type Listing = {
    title: string; url: string | null; cold_rent_eur: number | null;
    size_sqm: number | null; postal_code: string | null;
    source: string; rent_badge: string; delta_percent: number | null;
    overpayment_eur_per_year: number | null;
    legal_basis: string | null; recommendation: string | null;
  };

  async function loadProfiles(): Promise<void> {
    try {
      const r = await fetch(`${SB}/api/search/profiles`);
      if (!r.ok) return;
      const d = await r.json();
      const box = document.getElementById("sp-list");
      if (!box) return;
      const profiles = d.profiles as Profile[];
      box.innerHTML = profiles.length === 0
        ? '<p class="hint">Noch keine Profile — lege oben eines an.</p>'
        : profiles.map((p) => `
          <div class="profile-card">
            <span class="p-name">📁 ${p.name}</span>
            <span class="p-url" title="${p.url}">${p.url}</span>
            <button onclick="window.__refreshProfile(${p.id})" type="button">🔄 Jetzt prüfen</button>
            <button onclick="window.__showListings(${p.id})" type="button">📋 Treffer</button>
          </div>`).join("");
    } catch {
      /* Backend nicht erreichbar */
    }
  }

  window.__refreshProfile = async (id: number): Promise<void> => {
    const out = document.getElementById("sp-saved");
    try {
      const r = await fetch(`${SB}/api/search/refresh/${id}`, { method: "POST" });
      const d = await r.json();
      if (out) {
        out.textContent = `✅ ${d.profile_name}: ${(d.new_listings as Listing[]).length} neue Treffer (insgesamt ${d.total_seen} archiviert)`;
        out.hidden = false;
      }
      if ((d.new_listings as Listing[]).length > 0) {
        renderListings(d.new_listings, `${d.profile_name} — neue Treffer`);
      } else {
        renderListings([], `${d.profile_name} — keine neuen Treffer (alle bekannt)`);
      }
    } catch (e) {
      if (out) { out.textContent = `⚠️ ${e instanceof Error ? e.message : String(e)}`; out.hidden = false; }
    }
  };

  window.__showListings = async (id: number): Promise<void> => {
    try {
      const r = await fetch(`${SB}/api/search/listings/${id}`);
      if (!r.ok) return;
      const d = await r.json();
      renderListings(d.listings as Listing[], `${d.profile_name} — alle Treffer (${d.total_seen})`);
    } catch {
      /* ignore */
    }
  };

  function renderListings(listings: Listing[], title: string): void {
    const res = document.getElementById("sp-results");
    const box = document.getElementById("sp-listings");
    const head = document.getElementById("sp-results-title");
    if (!res || !box || !head) return;
    head.textContent = title;
    box.innerHTML = listings.length === 0
      ? "<p class='hint'>Keine (neuen) Treffer.</p>"
      : listings.map((l) => {
          const price = l.cold_rent_eur != null ? `${l.cold_rent_eur.toFixed(0)} €` : "?";
          const sqm = l.size_sqm != null ? `${l.size_sqm.toFixed(0)} m²` : "?";
          const delta = l.delta_percent != null ? ` (${l.delta_percent > 0 ? "+" : ""}${l.delta_percent.toFixed(0)}%)` : "";
          const overpay = l.overpayment_eur_per_year
            ? ` · <strong style="color:#b00020">+${l.overpayment_eur_per_year.toFixed(0)} €/Jahr zu viel</strong>`
            : "";
          return `
            <div class="listing-row">
              <span class="badge-sm">${badgeEmoji(l.rent_badge)}</span>
              ${l.url ? `<a href="${l.url}" target="_blank" rel="noopener noreferrer">${l.title.slice(0, 62)}</a>` : l.title.slice(0, 62)}
              <span>· ${price} · ${sqm}${l.postal_code ? ` · ${l.postal_code}` : ""} · ${l.source}${delta}${overpay}</span>
              <button class="wp-btn" onclick="window.__wohnprofil(${l.cold_rent_eur ?? 0}, '${l.postal_code ?? ""}')" type="button">🎯 Wohnprofil</button>
            </div>`;
        }).join("");
    res.hidden = false;
  }

  document.getElementById("sp-save")?.addEventListener("click", async () => {
    const name = (document.getElementById("sp-name") as HTMLInputElement | null)?.value?.trim() ?? "";
    const url = (document.getElementById("sp-url") as HTMLInputElement | null)?.value?.trim() ?? "";
    const out = document.getElementById("sp-saved");
    if (!name || !url) {
      if (out) { out.textContent = "⚠️ Name und URL bitte ausfüllen."; out.hidden = false; }
      return;
    }
    try {
      const r = await fetch(`${SB}/api/search/profiles`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, url }),
      });
      const d = await r.json();
      if (!r.ok) throw new Error(d.detail || `HTTP ${r.status}`);
      if (out) { out.textContent = `✅ Profil '${d.name}' gespeichert — jetzt 'Jetzt prüfen' klicken!`; out.hidden = false; }
      await loadProfiles();
    } catch (e) {
      if (out) { out.textContent = `⚠️ ${e instanceof Error ? e.message : String(e)}`; out.hidden = false; }
    }
  });

  loadProfiles();

  // ---- Einfache Ort-Suche: Text → Portal-URLs → Agent-Save ----
  let savedAgentUrls: Array<{ portal: string; url: string }> = [];
  document.getElementById("ort-go")?.addEventListener("click", async () => {
    const query = (document.getElementById("ort-input") as HTMLInputElement | null)?.value?.trim() ?? "";
    const maxRent = parseFloat((document.getElementById("ort-rent") as HTMLInputElement | null)?.value ?? "") || null;
    const rooms = parseFloat((document.getElementById("ort-rooms") as HTMLInputElement | null)?.value ?? "") || null;
    const hint = document.getElementById("ort-hint");
    const urlsBox = document.getElementById("ort-urls");
    const result = document.getElementById("ort-result");
    const saveBtn = document.getElementById("ort-save-agent") as HTMLButtonElement | null;
    if (!query) { if (hint) { hint.textContent = "⚠️ Bitte Ort, Bezirk oder PLZ eingeben."; } if (result) result.hidden = false; return; }
    try {
      const r = await fetch(`${SB}/api/search/ort`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query, max_rent: maxRent, rooms_min: rooms }),
      });
      const d = await r.json();
      if (hint) hint.textContent = d.hint as string;
      if (urlsBox) {
        savedAgentUrls = d.urls as Array<{ portal: string; url: string }>;
        urlsBox.innerHTML = savedAgentUrls.length === 0
          ? ""
          : savedAgentUrls.map((u) => `
            <div class="listing-row">
              <span class="badge-sm">🏢</span>
              <a href="${u.url}" target="_blank" rel="noopener noreferrer">${u.portal}</a>
              <span class="hint">${u.hint ?? ""}</span>
            </div>`).join("");
      }
      if (saveBtn) saveBtn.hidden = savedAgentUrls.length === 0;
      if (result) result.hidden = false;
    } catch (e) {
      if (hint) hint.textContent = `⚠️ ${e instanceof Error ? e.message : String(e)}`;
      if (result) result.hidden = false;
    }
  });

  document.getElementById("ort-save-agent")?.addEventListener("click", async () => {
    const query = (document.getElementById("ort-input") as HTMLInputElement | null)?.value?.trim() ?? "";
    const token = localStorage.getItem("mietspiegel_token");
    let saved = 0;
    let limitMsg: string | null = null;
    for (const entry of savedAgentUrls) {
      try {
        const r = await fetch(`${SB}/api/search/profiles?api_token=${token ?? ""}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name: `${query} (${entry.portal})`, url: entry.url }),
        });
        if (r.status === 201) { saved++; }
        else if (r.status === 402) { limitMsg = (await r.json()).detail ?? "Limit erreicht"; break; }
      } catch { /* Netzwerkfehler weiter */ }
    }
    const saveBtn = document.getElementById("ort-save-agent") as HTMLButtonElement | null;
    const hintEl = document.getElementById("ort-hint");
    if (saveBtn) {
      if (limitMsg) {
        saveBtn.textContent = `⚠️ ${saved} gespeichert — ${limitMsg}`;
        if (hintEl) hintEl.innerHTML = `⚠️ ${saved} von ${savedAgentUrls.length} Portalen gespeichert. ` +
          `<strong>${limitMsg}</strong> <a href="/preise" style="color:#0066cc;">Pläne ansehen →</a>`;
      } else {
        saveBtn.textContent = `✅ ${saved} Profile gespeichert!`;
        saveBtn.disabled = true;
      }
    }
    await loadProfiles();
  });

  // ---- Wohnprofil: Score + lokale Anbieter je Treffer ----
  window.__wohnprofil = async (rent: number, plz: string): Promise<void> => {
    const incomeStr = prompt("Nettoeinkommen/Monat (EUR)?", "2500");
    const income = parseFloat(incomeStr ?? "0") || 0;
    if (income <= 0) return;
    const nk = parseFloat(prompt("NK-Vorauszahlung/Monat (EUR)?", "150") ?? "150") || 150;
    const strom = parseFloat(prompt("Strom/Monat (EUR)?", "90") ?? "90") || 90;
    try {
      const r = await fetch(`${SB}/api/wohnprofil`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          cold_rent_eur: rent, nebenkosten_eur: nk, strom_eur: strom,
          net_income_eur: income,
        }),
      });
      if (!r.ok) throw new Error(`HTTP ${r.status}`);
      const d = await r.json();
      const ampel = d.ampel === "grün" ? "🟢" : d.ampel === "gelb" ? "🟡" : "🔴";
      let msg = `${ampel} WOHNPROFIL: ${d.score}/100 Punkte\nWohnkosten: ${d.housing_cost_percent}% des Einkommens\n\n`;
      for (const dim of d.dimensions as Array<{ label: string; points: number; weight: number; detail: string }>) {
        msg += `${dim.label}: ${dim.points}/${dim.weight} Punkte\n  ${dim.detail}\n`;
      }
      msg += `\n→ ${d.empfehlung as string}`;
      // Lokale Anbieter falls PLZ bekannt
      if (/^\d{5}$/.test(plz)) {
        try {
          const lr = await fetch(`${SB}/api/versorger/lokal/${plz}`);
          if (lr.ok) {
            const ld = await lr.json();
            msg += `\n\n🔌 LOKALE ANBIETER (${plz}):\n`;
            if (ld.grundversorger) {
              msg += `Grundversorger: ${ld.grundversorger.name}\n  (Ohne Vertrag = dessen teuerster Tarif!)\n`;
            } else {
              msg += `Grundversorger: siehe BNetzA-Suche\n  ${ld.bnetza_grundversorger_url}\n`;
            }
            if ((ld.lokale_versorger as string[]).length > 0) {
              msg += `Stadtwerke: ${ld.lokale_versorger.join(", ")}\n`;
            }
            msg += `Breitband prüfen: ${ld.breitband_check_url}`;
          }
        } catch { /* lokal-Info optional */ }
      }
      alert(msg.slice(0, 1500));
    } catch (e) {
      alert(`⚠️ ${e instanceof Error ? e.message : String(e)}`);
    }
  };
</script>
